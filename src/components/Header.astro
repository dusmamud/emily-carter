---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header id="site-header" class="sticky top-0 z-50 border-b border-line/60 bg-cream/92 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="flex min-h-[48px] items-center gap-2.5" aria-label="Emily Carter — home">
      <span class="grid h-11 w-11 place-items-center rounded-2xl bg-ink text-gold">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 6c-1.4-1.1-3.1-1.6-5.5-1.6v14c2.4 0 4.1.5 5.5 1.6 1.4-1.1 3.1-1.6 5.5-1.6v-14C15.1 4.4 13.4 4.9 12 6Z"/><path d="M12 6v14"/></svg>
      </span>
      <span class="leading-tight">
        <span class="font-display block whitespace-nowrap text-lg font-bold">{site.name}</span>
        <span class="block text-xs font-medium text-ink-soft">{site.role}</span>
      </span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {nav.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class={`flex min-h-[44px] items-center rounded-full px-4 text-[15px] font-semibold transition ${isActive(n.href) ? 'bg-ink text-white' : 'text-ink hover:bg-cream-2'}`}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href="/book/" class="btn btn-navy hidden !min-h-[48px] sm:inline-flex">Let's Connect <Icon name="arrow" size={17} /></a>
      <button id="menu-btn" type="button" class="grid h-12 w-12 place-items-center rounded-full border border-line bg-paper lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-line bg-paper px-4 py-3 lg:hidden">
    <ul class="space-y-1">
      {nav.map((n) => (
        <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class={`flex min-h-[48px] items-center rounded-xl px-4 font-semibold ${isActive(n.href) ? 'bg-ink text-white' : 'hover:bg-cream-2'}`}>{n.label}</a></li>
      ))}
      <li><a href="/pricing/" class="flex min-h-[48px] items-center rounded-xl px-4 font-semibold hover:bg-cream-2">Pricing</a></li>
      <li><a href="/faq/" class="flex min-h-[48px] items-center rounded-xl px-4 font-semibold hover:bg-cream-2">FAQ</a></li>
      <li><a href="/blog/" class="flex min-h-[48px] items-center rounded-xl px-4 font-semibold hover:bg-cream-2">Blog</a></li>
    </ul>
  </nav>
</header>
