---
import Stars from './Stars.astro';
import type { Testimonial } from '../data/site';
interface Props { t: Testimonial }
const { t } = Astro.props;
---
<figure class="card-hover reveal flex h-full flex-col rounded-3xl border border-line bg-paper p-6 shadow-[0_10px_35px_-20px_rgba(18,40,64,0.35)] sm:p-7">
  <div class="flex items-center gap-3">
    <img src={`/images/${t.avatar}-480.jpg`} alt={t.avatarAlt} width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 rounded-full object-cover" />
    <div>
      <figcaption class="font-display font-bold">{t.name}</figcaption>
      <p class="text-xs text-ink-soft">{t.role}</p>
    </div>
  </div>
  <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink-soft">&ldquo;{t.quote}&rdquo;</blockquote>
  <div class="mt-4 flex items-center justify-between gap-3">
    <Stars />
    <span class="rounded-full bg-cream-2 px-3 py-1 text-xs font-bold text-gold-deep">{t.result}</span>
  </div>
</figure>
