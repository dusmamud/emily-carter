---
// Reusable responsive picture: AVIF -> WebP -> JPG -> PNG fallback,
// widths 480/800/1200/1600 generated by scripts/convert-images.mjs
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  class?: string;
  imgClass?: string;
  sizes?: string;
}
const { name, alt, width, height, eager = false, class: cls = '', imgClass = '', sizes = '(max-width: 768px) 100vw, 50vw' } = Astro.props;
const widths = [480, 800, 1200, 1600];
const srcset = (ext: string) => widths.map((wd) => `/images/${name}-${wd}.${ext} ${wd}w`).join(', ');
---
<picture class={cls}>
  <source srcset={srcset('avif')} sizes={sizes} type="image/avif" />
  <source srcset={srcset('webp')} sizes={sizes} type="image/webp" />
  <source srcset={srcset('jpg')} sizes={sizes} type="image/jpeg" />
  <img src={`/images/${name}-800.jpg`} srcset={srcset('png')} sizes={sizes} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" class={imgClass} />
</picture>
