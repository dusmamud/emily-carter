---
interface Props { items: { q: string; a: string }[]; headingLevel?: 'h2' | 'h3' }
const { items, headingLevel: H = 'h3' } = Astro.props;
---
<div class="space-y-3">
  {items.map((f, i) => (
    <div class="reveal rounded-2xl border border-line bg-paper">
      <H>
        <button type="button" data-faq-btn aria-expanded={i === 0 ? 'true' : 'false'} class="flex min-h-[52px] w-full items-center justify-between gap-4 px-5 py-4 text-left font-display text-base font-bold sm:text-lg">
          {f.q}
          <span aria-hidden="true" class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-cream-2 text-lg font-bold">+</span>
        </button>
      </H>
      <div class="faq-panel" data-open={i === 0 ? 'true' : 'false'}>
        <div><p class="px-5 pb-5 text-[15px] leading-relaxed text-ink-soft">{f.a}</p></div>
      </div>
    </div>
  ))}
</div>
