---
import { nav, socials, site, contact } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="border-t border-line bg-paper">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <a href="/" class="flex items-center gap-2.5" aria-label="Emily Carter — home">
        <span class="grid h-11 w-11 place-items-center rounded-2xl bg-ink text-gold">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 6c-1.4-1.1-3.1-1.6-5.5-1.6v14c2.4 0 4.1.5 5.5 1.6 1.4-1.1 3.1-1.6 5.5-1.6v-14C15.1 4.4 13.4 4.9 12 6Z"/><path d="M12 6v14"/></svg>
        </span>
        <span class="leading-tight">
          <span class="font-display block whitespace-nowrap text-lg font-bold">{site.name}</span>
          <span class="block text-xs font-medium text-ink-soft">{site.role}</span>
        </span>
      </a>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-2 gap-y-1">
        {nav.map((n) => <a href={n.href} class="flex min-h-[44px] items-center rounded-full px-3 text-sm font-semibold hover:bg-cream-2">{n.label}</a>)}
        <a href="/pricing/" class="flex min-h-[44px] items-center rounded-full px-3 text-sm font-semibold hover:bg-cream-2">Pricing</a>
        <a href="/faq/" class="flex min-h-[44px] items-center rounded-full px-3 text-sm font-semibold hover:bg-cream-2">FAQ</a>
        <a href="/blog/" class="flex min-h-[44px] items-center rounded-full px-3 text-sm font-semibold hover:bg-cream-2">Blog</a>
        <a href="/book/" class="flex min-h-[44px] items-center rounded-full px-3 text-sm font-semibold hover:bg-cream-2">Book a Free Trial</a>
      </nav>
      <div class="flex items-center gap-2">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={`Emily Carter on ${s.label}`} class="grid h-11 w-11 place-items-center rounded-full border border-line text-ink transition hover:bg-ink hover:text-gold">
            <Icon name={s.icon} size={19} />
          </a>
        ))}
      </div>
    </div>
    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 text-sm text-ink-soft sm:flex-row sm:items-center">
      <p>© {site.year} {site.name}. All rights reserved.</p>
      <p>{contact.location}</p>
      <p class="flex gap-4">
        <a href="/privacy/" class="font-semibold text-ink hover:underline">Privacy</a>
        <a href="/terms/" class="font-semibold text-ink hover:underline">Terms</a>
      </p>
    </div>
  </div>
</footer>
