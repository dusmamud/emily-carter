---
import Icon from './Icon.astro';
import type { Course } from '../data/site';
import { gbp } from '../data/site';
interface Props { course: Course; headingLevel?: 'h2' | 'h3' }
const { course, headingLevel: H = 'h3' } = Astro.props;
---
<article class={`card-hover reveal flex h-full flex-col rounded-3xl p-6 sm:p-7 ${course.tint === 'blue' ? 'bg-sky-soft' : 'bg-peach'}`}>
  <span class="grid h-14 w-14 place-items-center rounded-full bg-white text-ink shadow-sm">
    <Icon name={course.icon} size={26} />
  </span>
  <H class="font-display mt-5 text-xl font-bold">{course.title}</H>
  <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink-soft">{course.short}</p>
  <p class="mt-3 text-sm font-semibold">{course.level.split(' ')[0]} · from {gbp(course.priceFrom)}/lesson</p>
  <a href={`/courses/${course.slug}/`} class="mt-4 inline-flex min-h-[44px] items-center gap-2 font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4 hover:gap-3 transition-all">
    Explore <Icon name="arrow" size={18} />
  </a>
</article>
