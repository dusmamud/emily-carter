---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { pricing, gbp } from '../data/site';
---
<Layout title="Pricing — English Lessons from £24 | Emily Carter" description="Transparent English lesson pricing: free 25-minute trial, single lessons £30, and packs of 5, 10 and 20 lessons from £24 per lesson. No contracts.">
  <PageHero eyebrow="Pricing" title="Simple, Honest" script="Pricing" text="Start free. Then pay per lesson or save with a pack. No contracts, no hidden fees — pause or stop any time." />
  <section class="px-4 pb-8 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="reveal on-dark rounded-[2rem] bg-ink p-7 text-white sm:p-9">
        <div class="flex flex-wrap items-center justify-between gap-5">
          <div>
            <p class="font-script text-3xl text-gold">Start free!</p>
            <h2 class="font-display mt-1 text-2xl font-bold sm:text-3xl">{pricing.trial.title} — {gbp(0)}</h2>
            <p class="mt-1 text-white/85">{pricing.trial.note}</p>
          </div>
          <a href="/book/" class="btn btn-gold">Book a Free Trial Lesson <Icon name="arrow" size={17} /></a>
        </div>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-4">
        <div class="card-hover reveal flex flex-col rounded-3xl border border-line bg-paper p-7">
          <h2 class="font-display text-xl font-bold">{pricing.single.title}</h2>
          <p class="font-display mt-3 text-4xl font-bold">{gbp(pricing.single.price)}</p>
          <p class="text-sm text-ink-soft">{pricing.single.per}</p>
          <p class="mt-3 flex-1 text-[15px] text-ink-soft">{pricing.single.note}</p>
          <a href="/book/" class="btn btn-outline mt-5 w-full">Book a Lesson</a>
        </div>
        {pricing.packs.map((p) => (
          <div class={`card-hover reveal relative flex flex-col rounded-3xl p-7 ${p.popular ? 'bg-ink text-white shadow-xl' : 'border border-line bg-paper'}`}>
            {p.popular && <span class="absolute -top-3 left-6 rounded-full bg-gold px-3 py-1 text-xs font-bold text-ink">Most Popular</span>}
            <h2 class="font-display text-xl font-bold">{p.lessons} Lessons Pack</h2>
            <p class="font-display mt-3 text-4xl font-bold">{gbp(p.price)}</p>
            <p class={`text-sm ${p.popular ? 'text-white/80' : 'text-ink-soft'}`}>{gbp(p.perLesson)} per lesson · <strong>{p.saving}</strong></p>
            <ul class={`mt-4 flex-1 space-y-2 text-[15px] ${p.popular ? 'text-white/90' : 'text-ink-soft'}`}>
              <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0 text-gold-deep" /> {p.lessons} × 50-minute lessons</li>
              <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0 text-gold-deep" /> Personal plan + homework</li>
              <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0 text-gold-deep" /> Valid for 6 months</li>
            </ul>
            <a href="/book/" class={`btn mt-5 w-full ${p.popular ? 'btn-gold' : 'btn-navy'}`}>Start with a Free Trial</a>
          </div>
        ))}
      </div>
      <p class="reveal mx-auto mt-7 max-w-2xl text-center text-[15px] leading-relaxed text-ink-soft">{pricing.note}</p>
    </div>
  </section>
  <CtaBanner />
</Layout>
