---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { resources, site } from '../../data/site';

export function getStaticPaths() {
  return resources.map((r) => ({ params: { slug: r.slug }, props: { sheet: r } }));
}
const { sheet } = Astro.props;
---
<Layout title={`${sheet.title} — Free Printable | Emily Carter, English Teacher`} description={sheet.description}>
  <section class="px-4 pb-16 pt-12 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <p class="no-print reveal"><a href="/resources/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">← All free resources</a></p>
      <div class="reveal mt-5 rounded-[2rem] border border-line bg-paper p-7 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">Free Study Sheet · Level {sheet.level}</p>
        <h1 class="font-display mt-3 text-3xl font-bold leading-tight sm:text-4xl">{sheet.title}</h1>
        <p class="mt-3 leading-relaxed text-ink-soft">{sheet.description}</p>
        {sheet.sections.map((s) => (
          <section class="mt-7">
            <h2 class="font-display text-xl font-bold">{s.heading}</h2>
            <ul class="mt-2.5 space-y-1.5">
              {s.lines.map((line) => <li class="flex gap-2 leading-relaxed"><Icon name="check" size={17} class="no-print mt-1 shrink-0 text-gold-deep" /><span>{line}</span></li>)}
            </ul>
          </section>
        ))}
        <p class="mt-9 border-t border-line pt-5 text-sm text-ink-soft">Free from {site.name}, {site.role} — {site.url}/resources/{sheet.slug}/ · Book a free trial lesson and learn these with Emily.</p>
      </div>
      <div class="no-print reveal mt-6 flex flex-wrap gap-3">
        <button type="button" id="print-sheet" class="btn btn-navy">Print / Save as PDF <Icon name="doc" size={17} /></button>
        <a href="/book/" class="btn btn-outline">Learn These in a Free Trial</a>
      </div>
    </div>
  </section>
  <script>
    document.getElementById('print-sheet')?.addEventListener('click', () => window.print());
  </script>
</Layout>
