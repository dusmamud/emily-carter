---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import CourseCard from '../components/CourseCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqList from '../components/FaqList.astro';
import { courses, testimonials, credentials, steps, faqs, posts, pricing, gbp, site } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'English Lessons with Emily Carter',
  description: site.description,
  provider: { '@type': 'Person', name: 'Emily Carter', jobTitle: 'English Teacher', url: site.url + '/' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5.0', reviewCount: '1000' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP', description: 'Free 25-minute trial lesson' },
};
const avatars = [
  { img: 'avatar-sarah', alt: 'Student Sarah' },
  { img: 'avatar-david', alt: 'Student David' },
  { img: 'avatar-anna', alt: 'Student Anna' },
];
---
<Layout title="Emily Carter — English Teacher | Master English with Confidence" jsonLd={jsonLd}>
  <!-- HERO — recreates the design screenshot -->
  <section class="relative overflow-hidden px-4 pb-14 pt-10 sm:px-6 sm:pt-14" aria-label="Introduction">
    <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-cream-2" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-32 top-64 h-72 w-72 rounded-full bg-sky-soft/60" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
      <div>
        <p data-hero class="inline-flex items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 text-sm font-semibold">
          <Icon name="sparkle" size={16} class="text-gold-deep" /> Learn • Practice • Achieve
        </p>
        <h1 data-hero class="font-display mt-5 text-[clamp(2.6rem,7vw,4.4rem)] font-bold leading-[1.04]">
          Master English<br />
          <span class="font-script script-underline text-[clamp(2.8rem,7.5vw,4.8rem)] font-semibold leading-[1.05] text-ink">with Confidence</span>
        </h1>
        <p data-hero class="mt-5 max-w-md text-lg leading-relaxed text-ink-soft">Professional English lessons, personalized for your goals — study smarter, speak better. Lessons from {gbp(24)}, for levels A1–C1.</p>
        <div data-hero class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/book/" class="btn btn-navy" data-magnetic>Book a Free Trial Lesson <Icon name="arrow" size={18} /></a>
          <a href="/courses/" class="btn btn-outline"><span class="grid h-6 w-6 place-items-center rounded-full bg-ink text-white"><Icon name="play" size={11} /></span> Explore My Courses</a>
        </div>
        <div data-hero class="mt-8 flex items-center gap-3">
          <span class="flex -space-x-3">
            {avatars.map((a) => <img src={`/images/${a.img}-480.jpg`} alt={a.alt} width="44" height="44" loading="lazy" class="h-11 w-11 rounded-full border-2 border-cream object-cover" />)}
            <span class="grid h-11 w-11 place-items-center rounded-full border-2 border-cream bg-gold text-xs font-bold" aria-hidden="true">1k+</span>
          </span>
          <p class="text-sm leading-snug"><strong class="font-display text-base">1,000+ Students</strong><br /><span class="text-ink-soft">learned with me</span></p>
        </div>
      </div>
      <div data-hero class="relative mx-auto w-full max-w-[520px]">
        <p class="font-script floaty absolute -left-2 top-2 z-10 -rotate-2 text-3xl font-semibold sm:left-2 sm:text-4xl" aria-hidden="true">Speak Fluently!</p>
        <svg class="absolute left-16 top-14 z-10 hidden w-10 rotate-12 text-ink sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4c6 1 12 6 14 14"/><path d="M12 18h6v-6"/></svg>
        <div class="blob overflow-hidden bg-sky-mid shadow-[0_30px_60px_-30px_rgba(18,40,64,0.45)]">
          <Picture name="hero" alt="Emily Carter, English teacher, smiling and holding an English Grammar book with Big Ben in London behind her" width={1040} height={1200} eager={true} sizes="(max-width: 1024px) 92vw, 520px" imgClass="aspect-[13/15] w-full object-cover object-top" />
        </div>
        <p class="absolute bottom-5 left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-full bg-paper/95 px-4 py-2 text-sm font-semibold shadow-lg backdrop-blur">
          <Icon name="award" size={17} class="text-gold-deep" /> TESOL Certified · 5+ Years
        </p>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW — from the screenshot -->
  <section class="px-4 py-10 sm:px-6" aria-label="About Emily">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.1fr_0.8fr]">
      <div class="reveal overflow-hidden rounded-[1.75rem] shadow-[0_24px_50px_-28px_rgba(18,40,64,0.5)]">
        <Picture name="about-desk" alt="A study desk with English books and a Union Jack mug of tea" width={900} height={700} sizes="(max-width: 1024px) 92vw, 380px" imgClass="aspect-[9/7] w-full object-cover" />
      </div>
      <div class="reveal">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">About Me <span class="h-px w-10 bg-gold" aria-hidden="true"></span></p>
        <h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">Hi, I'm Emily Carter</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">I'm an experienced English teacher, passionate about helping students achieve their language goals. With a friendly and effective teaching style, I make learning English enjoyable and practical.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/about/" class="btn btn-navy">Learn More <Icon name="arrow" size={17} /></a>
          <a href="/book/" class="btn btn-outline">Book a Free Trial Lesson</a>
        </div>
      </div>
      <ul class="reveal space-y-5">
        {credentials.map((c) => (
          <li class="flex items-center gap-4">
            <span class={`grid h-14 w-14 shrink-0 place-items-center rounded-full ${c.icon === 'star' ? 'bg-peach text-gold-deep' : 'bg-sky-soft text-ink'}`}><Icon name={c.icon} size={25} /></span>
            <span><strong class="font-display block text-lg font-bold">{c.title}</strong><span class="text-sm text-ink-soft">{c.text}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COURSES — from the screenshot -->
  <section class="px-4 py-12 sm:px-6" aria-label="Courses">
    <div class="mx-auto max-w-6xl">
      <div class="reveal text-center">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">My Courses</p>
        <h2 class="font-display mt-2 text-3xl font-bold sm:text-4xl">What I Teach</h2>
      </div>
      <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {courses.map((c) => <CourseCard course={c} />)}
      </div>
      <p class="reveal mt-7 text-center text-ink-soft">Not sure which course fits? <a href="/book/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">Book a free trial</a> and I'll recommend the right one for your level and goals.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="px-4 py-12 sm:px-6" aria-label="How it works">
    <div class="mx-auto max-w-6xl">
      <div class="reveal text-center">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">How It Works</p>
        <h2 class="font-display mt-2 text-3xl font-bold sm:text-4xl">Start in Three Simple Steps</h2>
      </div>
      <ol class="mt-9 grid gap-5 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="card-hover reveal relative rounded-3xl border border-line bg-paper p-7">
            <span class="font-display grid h-12 w-12 place-items-center rounded-full bg-ink text-lg font-bold text-gold" aria-hidden="true">{i + 1}</span>
            <h3 class="font-display mt-4 text-xl font-bold">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TESTIMONIALS — from the screenshot -->
  <section class="px-4 py-12 sm:px-6" aria-label="Testimonials">
    <div class="mx-auto max-w-6xl">
      <div class="reveal text-center">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">Testimonials</p>
        <h2 class="font-display mt-2 text-3xl font-bold sm:text-4xl">What My Students Say</h2>
      </div>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {testimonials.slice(0, 3).map((t) => <TestimonialCard t={t} />)}
      </div>
      <p class="reveal mt-7 text-center"><a href="/testimonials/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">Read more student stories</a></p>
    </div>
  </section>

  <!-- PRICING HINT -->
  <section class="px-4 py-10 sm:px-6" aria-label="Pricing">
    <div class="reveal mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 rounded-[2rem] bg-cream-2 px-7 py-8 text-center sm:px-10 md:flex-row md:text-left">
      <div>
        <h2 class="font-display text-2xl font-bold sm:text-3xl">Simple, honest pricing</h2>
        <p class="mt-1 text-ink-soft">Free trial first. Then lessons from {gbp(pricing.packs[2].perLesson)} each with a 20-lesson pack — no contracts, ever.</p>
      </div>
      <a href="/pricing/" class="btn btn-navy shrink-0">See Pricing <Icon name="arrow" size={17} /></a>
    </div>
  </section>

  <!-- BLOG PREVIEW -->
  <section class="px-4 py-12 sm:px-6" aria-label="From the blog">
    <div class="mx-auto max-w-6xl">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">Free Learning Tips</p>
          <h2 class="font-display mt-2 text-3xl font-bold sm:text-4xl">From Emily's Notebook</h2>
        </div>
        <a href="/blog/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">All articles</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {posts.map((p) => (
          <article class="card-hover reveal flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-paper">
            <a href={`/blog/${p.slug}/`} tabindex="-1" aria-hidden="true">
              <Picture name={p.image} alt={p.imageAlt} width={800} height={520} sizes="(max-width: 768px) 92vw, 360px" imgClass="aspect-[3/2] w-full object-cover" />
            </a>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-bold uppercase tracking-wider text-gold-deep">{p.readTime}</p>
              <h3 class="font-display mt-2 text-lg font-bold leading-snug"><a href={`/blog/${p.slug}/`} class="hover:underline">{p.title}</a></h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink-soft">{p.excerpt}</p>
              <span class="mt-4 inline-flex items-center gap-2 font-semibold">Read article <Icon name="arrow" size={16} /></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ PREVIEW -->
  <section class="px-4 py-12 sm:px-6" aria-label="Frequently asked questions">
    <div class="mx-auto max-w-3xl">
      <div class="reveal text-center">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-gold-deep">Questions</p>
        <h2 class="font-display mt-2 text-3xl font-bold sm:text-4xl">Good to Know</h2>
      </div>
      <div class="mt-8"><FaqList items={faqs.slice(0, 4)} /></div>
      <p class="reveal mt-6 text-center"><a href="/faq/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">See all questions</a></p>
    </div>
  </section>

  <CtaBanner />
</Layout>
