---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page Not Found — Emily Carter" description="This page could not be found." robots="noindex">
  <section class="px-4 py-20 text-center sm:px-6">
    <p class="font-script text-5xl text-gold-deep">Oops!</p>
    <h1 class="font-display mt-3 text-4xl font-bold sm:text-5xl">This page went missing</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">Even the best students lose a page sometimes. Let's get you back to learning.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-navy">Back to Home</a>
      <a href="/book/" class="btn btn-gold">Book a Free Trial Lesson <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</Layout>
