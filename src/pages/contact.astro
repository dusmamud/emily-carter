---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/site';
---
<Layout title="Contact Emily Carter — English Teacher" description="Contact Emily Carter about English lessons, courses or your free trial. Replies within one working day.">
  <PageHero eyebrow="Contact" title="Let's" script="Connect" text="Questions about lessons, levels or pricing? Send a message — or skip straight to a free trial lesson." />
  <section class="px-4 pb-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_360px]">
      <div class="reveal rounded-[2rem] border border-line bg-paper p-6 sm:p-9">
        <form id="contact-form" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="cf-name" class="mb-1.5 block font-semibold">Your name *</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required class="field" aria-describedby="cf-name-error" placeholder="e.g. Alex Smith" />
              <p id="cf-name-error" class="field-error" role="alert"></p>
            </div>
            <div>
              <label for="cf-email" class="mb-1.5 block font-semibold">Email address *</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required class="field" aria-describedby="cf-email-error" placeholder="you@example.com" />
              <p id="cf-email-error" class="field-error" role="alert"></p>
            </div>
            <div class="sm:col-span-2">
              <label for="cf-topic" class="mb-1.5 block font-semibold">Topic</label>
              <select id="cf-topic" name="topic" class="field">
                <option>General question</option><option>Free trial lesson</option><option>Courses & levels</option><option>Pricing & packs</option><option>Exam preparation</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="cf-message" class="mb-1.5 block font-semibold">Your message *</label>
              <textarea id="cf-message" name="message" rows="5" required class="field" aria-describedby="cf-message-error" placeholder="Tell me about your goals…"></textarea>
              <p id="cf-message-error" class="field-error" role="alert"></p>
            </div>
          </div>
          <button type="submit" class="btn btn-navy mt-6">Send Message <Icon name="arrow" size={17} /></button>
          <p class="mt-3 text-sm text-ink-soft">Demo form — no real data is sent. On the live site, messages go straight to Emily's inbox.</p>
        </form>
        <div id="contact-success" class="hidden rounded-3xl bg-cream-2 p-7 text-center">
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-ink text-gold"><Icon name="check" size={26} /></span>
          <h2 class="font-display mt-4 text-2xl font-bold">Thank you — message received!</h2>
          <p class="mx-auto mt-2 max-w-md text-ink-soft">Emily replies within one working day. Want to talk sooner? Book a free trial lesson instead.</p>
          <a href="/book/" class="btn btn-navy mt-5">Book a Free Trial Lesson</a>
        </div>
      </div>
      <aside class="space-y-5">
        <div class="reveal rounded-3xl border border-line bg-paper p-6">
          <h2 class="font-display text-xl font-bold">Contact details</h2>
          <ul class="mt-4 space-y-4 text-[15px]">
            <li class="flex gap-3"><Icon name="mail" size={20} class="mt-0.5 shrink-0 text-gold-deep" /><span><strong class="block">Email</strong><a href={`mailto:${contact.email}`} class="text-ink-soft underline decoration-gold decoration-2 underline-offset-4">{contact.email}</a></span></li>
            <li class="flex gap-3"><Icon name="globe" size={20} class="mt-0.5 shrink-0 text-gold-deep" /><span><strong class="block">Based in</strong><span class="text-ink-soft">{contact.location}</span></span></li>
            <li class="flex gap-3"><Icon name="clock" size={20} class="mt-0.5 shrink-0 text-gold-deep" /><span><strong class="block">Teaching hours</strong><span class="text-ink-soft">{contact.hours}</span></span></li>
          </ul>
        </div>
        <div class="reveal on-dark rounded-3xl bg-ink p-6 text-white">
          <p class="font-script text-3xl text-gold">Fastest way to start?</p>
          <p class="mt-2 text-white/85">Skip the emails — book a free trial and we will talk properly, face to face.</p>
          <a href="/book/" class="btn btn-gold mt-4 w-full">Book a Free Trial Lesson</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
