---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { courses } from '../data/site';
const levels = ['A1 — Beginner', 'A2 — Elementary', 'B1 — Intermediate', 'B2 — Upper Intermediate', 'C1 — Advanced', 'Not sure yet'];
---
<Layout title="Book a Free Trial Lesson — Emily Carter, English Teacher" description="Book your free 25-minute trial English lesson with Emily Carter: meet your teacher, check your level and get a personal learning plan. No payment, no obligation.">
  <PageHero eyebrow="Free Trial" title="Book Your Free" script="Trial Lesson" text="25 minutes, online, completely free. We will talk about your goals, check your level, and I will show you exactly how your personal plan would look." />
  <section class="px-4 pb-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_360px]">
      <div class="reveal rounded-[2rem] border border-line bg-paper p-6 sm:p-9">
        <form id="book-form" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="bk-name" class="mb-1.5 block font-semibold">Your name *</label>
              <input id="bk-name" name="name" type="text" autocomplete="name" required class="field" aria-describedby="bk-name-error" placeholder="e.g. Alex Smith" />
              <p id="bk-name-error" class="field-error" role="alert"></p>
            </div>
            <div>
              <label for="bk-email" class="mb-1.5 block font-semibold">Email address *</label>
              <input id="bk-email" name="email" type="email" autocomplete="email" required class="field" aria-describedby="bk-email-error" placeholder="you@example.com" />
              <p id="bk-email-error" class="field-error" role="alert"></p>
            </div>
            <div>
              <label for="bk-course" class="mb-1.5 block font-semibold">Course / goal *</label>
              <select id="bk-course" name="course" required class="field" aria-describedby="bk-course-error">
                <option value="">Choose a course…</option>
                {courses.map((c) => <option value={c.title}>{c.title}</option>)}
                <option value="Not sure yet">Not sure yet — advise me</option>
              </select>
              <p id="bk-course-error" class="field-error" role="alert"></p>
            </div>
            <div>
              <label for="bk-level" class="mb-1.5 block font-semibold">Current level *</label>
              <select id="bk-level" name="level" required class="field" aria-describedby="bk-level-error">
                <option value="">Choose your level…</option>
                {levels.map((l) => <option value={l}>{l}</option>)}
              </select>
              <p id="bk-level-error" class="field-error" role="alert"></p>
            </div>
            <div>
              <label for="bk-date" class="mb-1.5 block font-semibold">Preferred date *</label>
              <input id="bk-date" name="date" type="date" required class="field" aria-describedby="bk-date-error" />
              <p id="bk-date-error" class="field-error" role="alert"></p>
            </div>
            <div>
              <label for="bk-time" class="mb-1.5 block font-semibold">Preferred time (UK time) *</label>
              <select id="bk-time" name="time" required class="field" aria-describedby="bk-time-error">
                <option value="">Choose a time…</option>
                {['08:00', '10:00', '12:00', '14:00', '16:00', '18:00', '19:30'].map((t) => <option value={t}>{t} UK time</option>)}
              </select>
              <p id="bk-time-error" class="field-error" role="alert"></p>
            </div>
            <div class="sm:col-span-2">
              <label for="bk-tz" class="mb-1.5 block font-semibold">Your timezone</label>
              <input id="bk-tz" name="timezone" type="text" class="field" placeholder="e.g. Berlin (CET) — so I can convert your lesson time correctly" />
              <p class="mt-1.5 text-sm text-ink-soft">Lesson times above are UK time. Tell me your timezone and I will confirm the exact local time in my reply.</p>
            </div>
            <div class="sm:col-span-2">
              <label for="bk-message" class="mb-1.5 block font-semibold">Anything I should know? <span class="font-normal text-ink-soft">(optional)</span></label>
              <textarea id="bk-message" name="message" rows="4" class="field" placeholder="Your goal, your exam date, your deadline — anything that helps me prepare."></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn-navy mt-6 w-full sm:w-auto">Request My Free Trial <Icon name="arrow" size={17} /></button>
          <p class="mt-3 text-sm text-ink-soft">No payment needed. This demo form does not send real data — on the live site Emily confirms every request personally by email.</p>
        </form>
        <div id="book-success" tabindex="-1" class="hidden rounded-3xl bg-cream-2 p-7 text-center outline-none">
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-ink text-gold"><Icon name="check" size={26} /></span>
          <h2 class="font-display mt-4 text-2xl font-bold">Your free trial is requested!</h2>
          <p class="mt-2 font-semibold">Booking reference: <span id="bk-ref" class="rounded-lg bg-paper px-2 py-0.5">EC-00000</span></p>
          <p id="bk-detail" class="mx-auto mt-3 max-w-md text-ink-soft"></p>
          <a href="/courses/" class="btn btn-navy mt-6">Browse Courses While You Wait</a>
        </div>
      </div>
      <aside class="space-y-5">
        <div class="reveal rounded-3xl border border-line bg-paper p-6">
          <h2 class="font-display text-xl font-bold">What happens next?</h2>
          <ol class="mt-4 space-y-4">
            {[
              ['1', 'I confirm by email', 'Within one working day, with your video-call link and local time.'],
              ['2', 'We meet for 25 minutes', 'A friendly chat, a quick level check and your questions answered.'],
              ['3', 'You get a personal plan', 'Clear next steps and honest pricing — continue only if it feels right.'],
            ].map(([n, t, d]) => (
              <li class="flex gap-3"><span class="font-display grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gold font-bold">{n}</span><span><strong class="block">{t}</strong><span class="text-sm text-ink-soft">{d}</span></span></li>
            ))}
          </ol>
        </div>
        <div class="reveal rounded-3xl bg-sky-soft p-6">
          <h2 class="font-display text-xl font-bold">Good to know</h2>
          <ul class="mt-3 space-y-2 text-[15px] text-ink-soft">
            <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0" /> Completely free — no card required</li>
            <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0" /> Online, from anywhere in the world</li>
            <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0" /> Reschedule free with 12 hours notice</li>
            <li class="flex gap-2"><Icon name="check" size={17} class="mt-0.5 shrink-0" /> Levels A1–C1 welcome</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
  <script>
    // Preselect course from ?course=<slug> (client-side; page is prerendered)
    const slug = new URLSearchParams(window.location.search).get('course');
    if (slug) {
      const map: Record<string, string> = { 'general-english': 'General English', 'business-english': 'Business English', 'conversation-skills': 'Conversation Skills', 'exam-preparation': 'Exam Preparation' };
      const sel = document.getElementById('bk-course') as HTMLSelectElement | null;
      if (sel && map[slug]) sel.value = map[slug];
    }
  </script>
</Layout>
